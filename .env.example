VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Set the same values without the VITE_ prefix in the serverless environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only ingestion credentials. Never expose these with a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key
# Jobicy's public Canada feed does not require an API key.
# Himalayas' public remote feed does not require an API key.
# Optional employer-direct boards. Keep server-only and use valid JSON.
# Example: [{"provider":"greenhouse","board":"company","company":"Company"},{"provider":"lever","board":"company","company":"Company"},{"provider":"ashby","board":"company","company":"Company"}]
ATS_JOB_BOARDS=[]
CRON_SECRET=generate_a_long_random_secret
