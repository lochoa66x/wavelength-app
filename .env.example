VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public, non-secret market exposure gate. Keep false while US rows are staged
# and audited. Vite embeds this value at build time, so every change requires a
# new deployment. In Vercel, store this as Config rather than Secret.
VITE_US_MARKET_ENABLED=false

# Required public facts for the production Privacy Notice. These values are
# intentionally browser-visible; do not place secrets in VITE_ variables.
VITE_PRIVACY_OPERATOR_NAME=Verified legal operator name
VITE_PRIVACY_CONTACT_EMAIL=verified-privacy-contact@example.com
VITE_PRIVACY_JURISDICTION=Ontario, Canada
VITE_PRIVACY_MINIMUM_AGE=16
# Magic-link Auth is the default. Redirect allowlists and the email template are
# configured in Supabase Dashboard, not through a browser environment variable.
# Email OTP/code entry is intentionally not enabled by this release.

# Set the same values without the VITE_ prefix in the serverless environment.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Required shared server-only importer credentials. Never expose these with a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
CRON_SECRET=generate_a_long_random_secret

# Optional paid/partner feed credentials. Free public feeds continue without these.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOB_MARKETS=CA
JOOBLE_API_KEY=your_jooble_canada_api_key
JOOBLE_US_API_KEY=your_separate_jooble_us_api_key
# Jobicy's public Canada feed does not require an API key.
# Himalayas' public remote feed does not require an API key.
# Optional employer-direct boards. Keep server-only and use valid JSON.
# `market` is optional and defaults to CA. Example:
# [{"provider":"greenhouse","board":"company","company":"Company","market":"US"}]
ATS_JOB_BOARDS=[]
# Emergency server-only stop for reviewed importers. Comma-separated known IDs only:
# adzuna, ashby, greenhouse, himalayas, jobicy, jooble, lever. A market suffix
# narrows the stop, for example jooble:us or himalayas:ca.
JOB_SOURCE_DISABLED=
