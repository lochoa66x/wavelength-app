{
  "functions": {
    "api/tailor.js": {
      "maxDuration": 300
    },
    "api/job-intake.js": {
      "maxDuration": 90
    },
    "api/listing-enrichment.js": {
      "maxDuration": 60
    },
    "api/cron/adzuna.js": {
      "maxDuration": 300
    },
    "api/cron/jooble.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/adzuna",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/cron/jooble",
      "schedule": "50 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/auth/callback", "destination": "/index.html" }
  ]
}
